# Copie para backend/.env (ou .env na raiz) e ajuste.

# --- Notificações (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Agendamento: off | 3x (08h,14h,20h) | daily (09h) | cron de 5 campos ---
RADAR_SCHEDULE=off

# --- Navegador ---
BROWSER_HEADLESS=true
# BROWSER_EXECUTABLE_PATH=/caminho/para/chrome   # opcional
# BROWSER_IGNORE_HTTPS_ERRORS=false              # só em redes com proxy TLS próprio

# --- Meta Ads Library (ritmo conservador = menos bloqueio) ---
META_COUNTRY=BR
META_MIN_DELAY_S=8
META_COOLDOWN_S=60
META_MAX_COOLDOWNS=3
META_MAX_PAGES_PER_ADVERTISER=4

# --- Rodada ---
DISCOVERY_MIN_QUERIES=30
DISCOVERY_MAX_QUERIES=45
MAX_ADVERTISERS_PER_RUN=25
MAX_LANDING_PAGES_PER_RUN=12
MAX_DEMAND_CHECKS_PER_RUN=5
LOW_TICKET_MIN_BRL=10
LOW_TICKET_MAX_BRL=100

# --- Busca externa (validação de demanda) ---
# ordem de tentativa; brave_api exige chave (https://brave.com/search/api/)
SEARCH_PROVIDERS=brave_api,bing,duckduckgo
BRAVE_API_KEY=

# --- Banco: SQLite por padrão; PostgreSQL: postgresql+psycopg://user:pass@host/radar ---
# DATABASE_URL=

# --- Email (opcional, interface pronta) ---
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  ALERT_EMAIL_TO=
